---
import '../styles/global.css';
import type { Project, ProjectCategory } from '../data/projects';
import { authorBlogUrl, repositoryUrl, siteName } from '../data/site';
import { defaultLocale, languages, type Locale, projectCategoryLabels, translate } from '../i18n';
import { categoryPath, pagePath, pages, projectPath, publicRoutes, type Page } from '../i18n/routes';

interface Props {
  locale: Locale;
  page: Page | 'notFound';
  project?: Project;
  category?: ProjectCategory;
}

const { locale, page, project, category } = Astro.props;
const t = translate(locale);
const notFound = page === 'notFound';
const categoryLabel = category && projectCategoryLabels[category];
const pageTitle = project ? t('projectPageTitle').replace('{project}', () => project.name)
  : categoryLabel ? t(`${categoryLabel}Name`) : t(`${page}Title`);
const title = `${pageTitle} | ${siteName}`;
const description = project ? t('projectMeta').replace('{project}', () => project.name)
  : categoryLabel ? t(`${categoryLabel}Description`) : t(`${page}Meta`);
const currentPath = (target: Locale) => {
  if (project) return projectPath(target, project.id);
  if (category) return categoryPath(target, category);
  return pagePath(target, notFound ? 'home' : page);
};
const canonical = new URL(currentPath(locale), Astro.site);
const alternates = publicRoutes.filter((route) =>
  route.page === (notFound ? 'home' : page) && route.project?.id === project?.id && route.category === category);
const navCurrent = (item: Page) => item === page ? (project || category ? 'location' : 'page') : undefined;
const openGraphLocales = {
  en: 'en_US', 'zh-CN': 'zh_CN', 'zh-TW': 'zh_TW', ja: 'ja_JP', es: 'es_ES', fr: 'fr_FR',
} satisfies Record<Locale, string>;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {notFound ? <meta name="robots" content="noindex" /> : (
      <>
        <link rel="canonical" href={canonical.href} />
        <link rel="alternate" hreflang="x-default" href={new URL(currentPath(defaultLocale), Astro.site).href} />
        {alternates.map(({ locale, path }) => (
          <link rel="alternate" hreflang={locale} href={new URL(path, Astro.site).href} />
        ))}
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={siteName} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={new URL('/evan-social.jpg', Astro.site).href} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="900" />
        <meta property="og:image:alt" content={t('heroImageAlt')} />
        <meta property="og:locale" content={openGraphLocales[locale]} />
        {alternates.filter((route) => route.locale !== locale).map(({ locale }) => (
          <meta property="og:locale:alternate" content={openGraphLocales[locale]} />
        ))}
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={pagePath(locale, 'home')}>
          <img src="/favicon.svg" width="34" height="34" alt="" />
          <span lang="en">{siteName}</span>
        </a>
        <nav class="primary-nav" aria-label={t('primaryNav')}>
          {pages.map((item) => (
            <a href={pagePath(locale, item)} aria-current={navCurrent(item)}>{t(item)}</a>
          ))}
        </nav>
        <div class="header-actions">
          <details class="language-picker">
            <summary>
              <span class="globe" aria-hidden="true"></span>
              <span class="visually-hidden">{t('language')} </span>
              <span lang={locale}>{languages[locale]}</span>
            </summary>
            <ul>
              {alternates.map(({ locale: target, path }) => (
                <li>
                  <a href={path} lang={target} hreflang={target} aria-current={!notFound && target === locale ? 'page' : undefined}>
                    {languages[target]}
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <a
            class="repository-link"
            href={repositoryUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('repositoryLink')}
            title={t('repositoryLink')}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.15c-3.2.7-3.88-1.36-3.88-1.36-.53-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.17 1.18a11.05 11.05 0 0 1 5.77 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.24 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.4-5.25 5.68.41.36.78 1.06.78 2.14v3.18c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/>
            </svg>
          </a>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div>
          <a class="brand" href={pagePath(locale, 'home')}>
            <img src="/favicon.svg" width="28" height="28" alt="" />
            <span lang="en">{siteName}</span>
          </a>
          <p>{t('footerNote')}</p>
        </div>
        <nav aria-label={t('footerNavigation')}>
          {pages.slice(1).map((item) => (
            <a href={pagePath(locale, item)} aria-current={navCurrent(item)}>{t(item)}</a>
          ))}
          <a href={authorBlogUrl}>{t('authorBlog')}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
