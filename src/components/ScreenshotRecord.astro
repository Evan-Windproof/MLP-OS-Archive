---
import type { Project } from '../data/projects';
import { translate, type Locale } from '../i18n';
import { formatArchiveDate, localizedArchiveText } from '../i18n/archive';

interface Props {
  item: NonNullable<Project['screenshots']>[number];
  locale: Locale;
  originalLanguage: string;
}

const { item, locale, originalLanguage } = Astro.props;
const t = translate(locale);
const caption = localizedArchiveText(item.captions ?? {}, locale, originalLanguage) ?? {
  text: item.alt ?? t('projectScreenshot'),
  language: item.alt ? item.language ?? originalLanguage : locale,
};
const imageSize = item.embed && item.imageSize;
const Heading = imageSize ? 'h3' : 'h4';
---

<li>
  {imageSize && (
    <>
      <a class="screenshot-image" href={item.url} target="_blank" rel="noopener noreferrer"
        aria-label={`${t('screenshotOpen')} · ${caption.text}`}>
        <img src={item.url} width={imageSize.width} height={imageSize.height}
          loading="lazy" decoding="async" referrerpolicy="no-referrer"
          alt={item.alt ?? caption.text} lang={item.alt ? item.language ?? originalLanguage : caption.language} />
      </a>
      <p data-image-error role="status" hidden>{t('screenshotLoadError')}</p>
    </>
  )}
  <Heading lang={caption.language}>{caption.text}</Heading>
  {item.description && <p lang={item.language ?? originalLanguage}>{item.description}</p>}
  <p>{t('screenshotCredit')} {item.credit}</p>
  {item.license && <p>{t('projectLicense')} {item.license}</p>}
  {item.capturedAt && <p><time datetime={item.capturedAt.value}>{formatArchiveDate(item.capturedAt, locale)}</time></p>}
  <ul class="record-links">
    <li>
      <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${t('screenshotOpen')} · ${caption.text}`}>
        {t('screenshotOpen')} <span aria-hidden="true">↗</span>
      </a>
    </li>
    {item.sourceUrl && item.sourceUrl !== item.url && (
      <li>
        <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`${t('projectSource')} · ${caption.text}`}>
          {t('projectSource')} <span aria-hidden="true">↗</span>
        </a>
      </li>
    )}
  </ul>
</li>
