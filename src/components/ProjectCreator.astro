---
import type { Project } from '../data/projects';
import { translate, type Locale } from '../i18n';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = translate(locale);
---

{project.developer && project.developerUrl ? (
  <a href={project.developerUrl} target="_blank" rel="noopener noreferrer">
    {project.developer} <span aria-hidden="true">↗</span>
  </a>
) : project.developer ?? t('status-unknown')}
