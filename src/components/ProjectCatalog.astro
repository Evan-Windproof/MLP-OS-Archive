---
import { projects } from '../data/project-records';
import { projectCategoryLabels, translate, type Locale } from '../i18n';
import { pagePath } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translate(locale);
---

{projects.length ? (
  <section aria-labelledby="catalog-records">
    <h2 id="catalog-records">{t('projectRecords')}</h2>
    <ul class="category-grid">
      {projects.map((project) => {
        const language = Object.hasOwn(project.description, locale) ? locale : project.originalLanguage;
        const links = [
          { url: project.officialWebsite, label: t('projectWebsite') },
          { url: project.sourceCodeUrl, label: t('projectRepository') },
          { url: project.downloadUrl, label: t('projectDownload') },
        ];
        return (
          <li class:list={['category-card', 'project-record', project.category]} id={`project-${project.id}`}>
            <h3>{project.name}</h3>
            <p>{t(`${projectCategoryLabels[project.category]}Name`)}</p>
            <p lang={language}>{project.description[language]}</p>
            <dl>
              <dt>{t('developmentLabel')}</dt><dd>{t(`status-${project.developmentStatus}`)}</dd>
              <dt>{t('verificationLabel')}</dt><dd>{t(`status-${project.verificationStatus}`)}</dd>
            </dl>
            <ul class="record-links">
              {links.map(({ url, label }) => url && <li><a href={url}>{label}</a></li>)}
              {project.documentation?.map((url, index) => (
                <li><a href={url}>{t('projectDocumentation')} {index + 1}</a></li>
              ))}
              {project.references.map((url, index) => (
                <li><a href={url}>{t('projectSource')} {index + 1}</a></li>
              ))}
              {project.screenshots?.map(({ url, credit, license }) => (
                <li><a href={url}>{t('projectScreenshot')}</a> — {credit}{license && ` (${license})`}</li>
              ))}
            </ul>
          </li>
        );
      })}
    </ul>
  </section>
) : (
  <section class="feature-panel catalog-empty">
    <h2>{t('catalogEmptyTitle')}</h2>
    <p>{t('catalogEmptyBody')}</p>
    <a class="text-link" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
  </section>
)}
