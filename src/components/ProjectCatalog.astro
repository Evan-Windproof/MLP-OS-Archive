---
import { projects } from '../data/project-records';
import { projectCategories } from '../data/projects';
import { projectDescription } from '../i18n/archive';
import { projectCategoryLabels, translate, type Locale } from '../i18n';
import { pagePath, projectPath } from '../i18n/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translate(locale);
---

{projectCategories.map((category) => {
  const records = projects.filter((project) => project.category === category);
  return (
    <section class="catalog-records" aria-labelledby={`records-${category}`}>
      <h2 id={`records-${category}`}>
        {t(`${projectCategoryLabels[category]}Name`)}
        <span class="catalog-count">({new Intl.NumberFormat(locale).format(records.length)})</span>
      </h2>
      <p class="section-intro">{t(`${projectCategoryLabels[category]}Description`)}</p>
      {records.length ? (
        <ul class="category-grid">
          {records.map((project) => {
            const description = projectDescription(project, locale);
            return (
              <li class:list={['category-card', 'project-record', category]} id={`project-${project.id}`}>
                <h3><a href={projectPath(locale, project.id)}>{project.name}</a></h3>
                <p lang={description.language}>{description.text}</p>
                <dl>
                  <dt>{t('developmentLabel')}</dt><dd>{t(`status-${project.developmentStatus}`)}</dd>
                  <dt>{t('verificationLabel')}</dt><dd>{t(`status-${project.verificationStatus}`)}</dd>
                </dl>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="feature-panel catalog-empty">
          <p>{t('categoryEmpty')}</p>
          <a class="text-link" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
        </div>
      )}
    </section>
  );
})}
