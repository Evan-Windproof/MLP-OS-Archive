---
import type { ProjectCategory } from '../data/projects';

interface Props {
  category: ProjectCategory;
}
const { category } = Astro.props;
---
<svg viewBox="0 0 40 40" width="30" height="30" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
  {category === 'independent-os' && (
    <>
      <path d="m20 4 3 11 11 5-11 4-3 12-4-12-10-4 10-5z" fill="currentColor" fill-opacity=".12" />
      <path d="M20 16v8m-4-4h8M31 7v5m-2.5-2.5h5M10 29v5m-2.5-2.5h5" />
    </>
  )}
  {category === 'linux-distribution' && (
    <>
      <path d="M7 21a13 13 0 0 1 26 0m-22 0a9 9 0 0 1 18 0m-14 0a5 5 0 0 1 10 0" />
      <path d="M11 30h20a4 4 0 0 0 .3-8 5.5 5.5 0 0 0-10-1 6 6 0 0 0-10 2A3.6 3.6 0 1 0 11 30Z" fill="currentColor" fill-opacity=".12" />
    </>
  )}
  {category === 'desktop-customization' && (
    <>
      <path d="M9 14a11 11 0 0 1 22 0v17H9zM9 25h22" fill="currentColor" fill-opacity=".12" />
      <path d="M19.5 17c-3-5-10-1 .5 6 10.5-7 3.5-11 .5-6zM20 8v3" />
    </>
  )}
</svg>
