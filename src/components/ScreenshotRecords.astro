---
import type { Project } from '../data/projects';
import { translate, type Locale } from '../i18n';
import { formatArchiveDate, localizedArchiveText } from '../i18n/archive';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
const t = translate(locale);
const screenshots = project.screenshots ?? [];
---

{screenshots.length > 0 && (
  <section class="feature-panel" id="screenshots" aria-labelledby="screenshot-records-title">
    <h2 id="screenshot-records-title">{t('projectScreenshots')}</h2>
    <ul class="archive-items" role="list">
      {screenshots.map((item) => {
        const caption = localizedArchiveText(item.captions ?? {}, locale, project.originalLanguage) ?? {
          text: item.alt ?? t('projectScreenshot'),
          language: item.alt ? item.language ?? project.originalLanguage : locale,
        };
        return (
          <li>
            <h3 lang={caption.language}>{caption.text}</h3>
            {item.description && <p lang={item.language ?? project.originalLanguage}>{item.description}</p>}
            <p>{t('screenshotCredit')} {item.credit}</p>
            {item.license && <p>{t('projectLicense')} {item.license}</p>}
            {item.capturedAt && <p><time datetime={item.capturedAt.value}>{formatArchiveDate(item.capturedAt, locale)}</time></p>}
            <ul class="record-links">
              <li>
                <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`${t('screenshotOpen')} · ${caption.text}`}>
                  {t('screenshotOpen')} <span aria-hidden="true">↗</span>
                </a>
              </li>
              {item.sourceUrl && item.sourceUrl !== item.url && (
                <li>
                  <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`${t('projectSource')} · ${caption.text}`}>
                    {t('projectSource')} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              )}
            </ul>
          </li>
        );
      })}
    </ul>
    <p class="screenshot-rights">{t('screenshotRights')}</p>
  </section>
)}
