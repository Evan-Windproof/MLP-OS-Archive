---
import type { Project } from '../data/projects';
import { formatArchiveDate, projectDescription } from '../i18n/archive';
import { projectCategoryLabels, translate, type Locale } from '../i18n';
import { categoryPath, pagePath } from '../i18n/routes';
import ArchiveTimeline from './ArchiveTimeline.astro';
import SourceLinks from './SourceLinks.astro';

interface Props {
  locale: Locale;
  project: Project;
}
const { locale, project } = Astro.props;
const t = translate(locale);
const description = projectDescription(project, locale);
const affiliation = project.sharedMaintainerAccount && t('sharedMaintainerEvidence')
  .replace('{project}', () => project.name)
  .replace('{account}', () => project.sharedMaintainerAccount ?? '');
const technical = [
  { label: t('projectAliases'), value: project.aliases?.join(', ') },
  { label: t('projectDeveloper'), value: project.developer },
  { label: t('projectDevelopmentYear'), value: project.developmentYear?.toString() },
  { label: t('projectLastUpdated'), value: project.lastUpdated && formatArchiveDate({ precision: 'day', value: project.lastUpdated }, locale) },
  { label: t('projectBase'), value: project.baseSystem },
  { label: t('projectKernel'), value: project.kernel },
  { label: t('projectLicense'), value: project.license },
].filter(({ value }) => value);
const projectLinks = [
  { label: t('projectWebsite'), url: project.officialWebsite },
  { label: t('projectRepository'), url: project.sourceCodeUrl },
  { label: t('projectDownload'), url: project.downloadUrl },
  ...(project.documentation ?? []).map((url, index) => ({ label: `${t('projectDocumentation')} ${index + 1}`, url })),
];
---

<header class="page-banner banner-catalog">
  <div class="shell">
    <a class="text-link" href={pagePath(locale, 'catalog')}>{t('catalog')}</a>
    <h1>{project.name}</h1>
    <p><a class="text-link" href={categoryPath(locale, project.category)}>{t(`${projectCategoryLabels[project.category]}Name`)}</a></p>
  </div>
</header>

<div class="shell page-content project-detail">
  <section class="feature-panel">
    <h2>{t('projectOverview')}</h2>
    <p lang={description.language}>{description.text}</p>
    <dl class="archive-facts">
      <dt>{t('developmentLabel')}</dt><dd>{t(`status-${project.developmentStatus}`)}</dd>
    </dl>
    <div class="verification-panel">
      <h3>{t('verificationLabel')} · {t(`status-${project.verificationStatus}`)}</h3>
      <p>{t(`verification-note-${project.verificationStatus}`)}</p>
      <p>{t('verificationScope')}</p>
      {affiliation && <p>{affiliation}</p>}
    </div>
    {projectLinks.some(({ url }) => url) && (
      <ul class="record-links">
        {projectLinks.map(({ label, url }) => url && <li><a href={url}>{label}</a></li>)}
      </ul>
    )}
  </section>

  <section class="feature-panel">
    <h2>{t('technicalInformation')}</h2>
    {technical.length ? (
      <dl class="archive-facts">
        {technical.map(({ label, value }) => <><dt>{label}</dt><dd>{value}</dd></>)}
      </dl>
    ) : <p>{t('archiveEmpty')}</p>}
  </section>

  <section class="feature-panel">
    <h2>{t('developmentHistory')}</h2>
    {project.historicalNotes && <p lang={project.originalLanguage}>{project.historicalNotes}</p>}
    {project.events?.length ? <ArchiveTimeline {locale} projectId={project.id} /> : <p>{t('timelineEmpty')}</p>}
  </section>

  <section class="feature-panel">
    <h2>{t('projectScreenshots')}</h2>
    {project.screenshots?.length ? (
      <ul class="archive-items">
        {project.screenshots.map((item) => (
          <li>
            <h3><a href={item.url} lang={item.alt ? item.language ?? project.originalLanguage : locale}>{item.alt ?? t('projectScreenshot')}</a></h3>
            {item.description && <p lang={item.language ?? project.originalLanguage}>{item.description}</p>}
            <p>{t('screenshotCredit')} {item.credit}</p>
            {item.license && <p>{t('projectLicense')} {item.license}</p>}
            {item.capturedAt && <p><time datetime={item.capturedAt.value}>{formatArchiveDate(item.capturedAt, locale)}</time></p>}
            {item.sourceUrl && <a href={item.sourceUrl}>{t('projectSource')}</a>}
          </li>
        ))}
      </ul>
    ) : <p>{t('archiveEmpty')}</p>}
  </section>

  <section class="feature-panel">
    <h2>{t('projectReleases')}</h2>
    {project.releases?.length ? (
      <ul class="archive-items">
        {project.releases.map((release) => (
          <li>
            <h3>{release.version}</h3>
            <p>
              {release.date ? <time datetime={release.date.value}>{formatArchiveDate(release.date, locale)}</time> : t('timelineUndated')}
              {' · '}{t(`release-${release.type}`)}{' · '}{t(`availability-${release.availability}`)}
            </p>
            {release.notes && <p lang={project.originalLanguage}>{release.notes}</p>}
            <dl class="archive-facts">
              {release.fileName && <><dt>{t('releaseFile')}</dt><dd>{release.fileName}</dd></>}
              {release.fileSizeBytes && <><dt>{t('releaseSize')}</dt><dd>{new Intl.NumberFormat(locale, { style: 'unit', unit: 'byte' }).format(release.fileSizeBytes)}</dd></>}
              {release.sha256 && <><dt>SHA-256</dt><dd><code>{release.sha256}</code></dd></>}
            </dl>
            <ul class="record-links">
              {release.originalDownloadUrl && <li><a href={release.originalDownloadUrl}>{t('originalDownload')}</a></li>}
              {release.archivedDownloadUrl && <li><a href={release.archivedDownloadUrl}>{t('archivedDownload')}</a></li>}
            </ul>
            <SourceLinks {locale} urls={release.references} />
          </li>
        ))}
      </ul>
    ) : <p>{t('archiveEmpty')}</p>}
  </section>

  <section class="feature-panel">
    <h2>{t('projectReferences')}</h2>
    <SourceLinks {locale} urls={project.references} />
  </section>
</div>
