---
import { projectCategories, type ProjectCategory } from '../data/projects';
import { type Locale, translate } from '../i18n';

interface Props {
  locale: Locale;
}

const t = translate(Astro.props.locale);
const messagePrefixes = {
  'independent-os': 'independent',
  'linux-distribution': 'linux',
  'desktop-customization': 'desktop',
} as const satisfies Record<ProjectCategory, string>;
---

<ul class="category-grid">
  {projectCategories.map((category) => {
    const prefix = messagePrefixes[category];
    return (
      <li class:list={['category-card', category]}>
        <span class="category-icon" aria-hidden="true"><span></span></span>
        <h3>{t(`${prefix}Name`)}</h3>
        <p>{t(`${prefix}Description`)}</p>
      </li>
    );
  })}
</ul>
