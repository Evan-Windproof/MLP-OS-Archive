---
import { projectsByCategory } from '../data/project-records';
import { projectCategories } from '../data/projects';
import { formatProjectCount } from '../i18n/archive';
import { type Locale, projectCategoryLabels, translate } from '../i18n';
import { categoryPath } from '../i18n/routes';
import CategoryIcon from './CategoryIcon.astro';

interface Props {
  locale: Locale;
  landing?: boolean;
}

const { locale, landing = false } = Astro.props;
const t = translate(locale);
const Heading = landing ? 'h2' : 'h3';
---

<ul class:list={['category-grid', 'category-links', { 'category-landing': landing }]}>
  {projectCategories.map((category) => {
    const prefix = projectCategoryLabels[category];
    const labelId = `category-title-${category}`;
    const descriptionId = `category-description-${category}`;
    const countId = `category-count-${category}`;
    return (
      <li>
        <a class:list={['category-card', 'category-link', category]} href={categoryPath(locale, category)} aria-labelledby={labelId} aria-describedby={landing ? `${descriptionId} ${countId}` : descriptionId}>
          <span class="category-icon"><CategoryIcon {category} /></span>
          <Heading id={labelId}>{t(`${prefix}Name`)}</Heading>
          <p id={descriptionId}>{t(`${prefix}Description`)}</p>
          {landing && (
            <div class="category-card-footer">
              <span id={countId}>{formatProjectCount(projectsByCategory[category].length, locale)}</span>
              <span class="category-browse">{t('browseCategory')}</span>
            </div>
          )}
        </a>
      </li>
    );
  })}
</ul>
