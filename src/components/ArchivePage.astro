---
import { repositoryUrl, siteName } from '../data/site';
import { translate, type Locale } from '../i18n';
import { pagePath, type Page } from '../i18n/routes';
import ArchiveIllustration from './ArchiveIllustration.astro';
import CategoryCards from './CategoryCards.astro';

interface Props {
  locale: Locale;
  page: Page;
}

const { locale, page } = Astro.props;
const t = translate(locale);
const submissions = ['submissionOs', 'submissionLinux', 'submissionDesktop', 'submissionHistory', 'submissionMedia', 'submissionCorrections'] as const;
const introductions = {
  catalog: 'catalogIntroPage',
  history: 'historyIntro',
  contribute: 'contributeIntro',
  about: 'aboutIntro',
} as const;
---

{page === 'home' ? (
  <>
    <section class="shell home-hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow" lang="en"><span aria-hidden="true">✦</span> {siteName}</p>
        <h1 id="hero-title">{t('homeTitle')}</h1>
        <p class="hero-intro">{t('heroIntro')}</p>
        <div class="actions">
          <a class="button" href={pagePath(locale, 'catalog')}>{t('exploreCatalog')}</a>
          <a class="button button-secondary" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
        </div>
      </div>
      <ArchiveIllustration />
    </section>

    <section class="catalog-band" aria-labelledby="collection-title">
      <div class="shell">
        <h2 id="collection-title">{t('catalogSection')}</h2>
        <p class="section-intro">{t('catalogIntro')}</p>
        <CategoryCards {locale} />
      </div>
    </section>

    <div class="shell home-panels">
      <section class="feature-panel">
        <h2>{t('missionTitle')}</h2>
        <p>{t('missionBody')}</p>
        <a class="text-link" href={pagePath(locale, 'history')}>{t('historyLink')}</a>
      </section>
      <section class="feature-panel contribution-panel">
        <h2>{t('communityTitle')}</h2>
        <p>{t('communityBody')}</p>
        <a class="text-link" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
      </section>
    </div>
  </>
) : (
  <>
    <header class="page-banner">
      <div class="shell">
        <h1>{t(`${page}Title`)}</h1>
        <p>{t(introductions[page])}</p>
      </div>
    </header>

    <div class="shell page-content">
      {page === 'catalog' && (
        <>
          <section aria-labelledby="catalog-categories">
            <h2 id="catalog-categories">{t('catalogSection')}</h2>
            <CategoryCards {locale} />
          </section>
          <section class="feature-panel">
            <h2>{t('catalogEmptyTitle')}</h2>
            <p>{t('catalogEmptyBody')}</p>
            <a class="text-link" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
          </section>
        </>
      )}

      {page === 'history' && (
        <>
          <section class="feature-panel">
            <h2>{t('historyPreserveTitle')}</h2>
            <p>{t('historyPreserveBody')}</p>
          </section>
          <section class="feature-panel">
            <h2>{t('historyTimelineTitle')}</h2>
            <p>{t('historyTimelineBody')}</p>
          </section>
        </>
      )}

      {page === 'contribute' && (
        <>
          <section class="feature-panel">
            <h2>{t('submissionTitle')}</h2>
            <ul class="submission-list">
              {submissions.map((key) => <li>{t(key)}</li>)}
            </ul>
          </section>
          <section class="feature-panel contribution-panel">
            <h2>{t('githubTitle')}</h2>
            <p>{t('githubBody')}</p>
            <a class="button" href={repositoryUrl}>{t('githubLink')}</a>
          </section>
        </>
      )}

      {page === 'about' && (
        <>
          <section class="feature-panel">
            <h2>{t('aboutPreserveTitle')}</h2>
            <p>{t('aboutPreserveBody')}</p>
          </section>
          <section class="feature-panel">
            <h2>{t('aboutCommunityTitle')}</h2>
            <p>{t('aboutCommunityBody')}</p>
            <a class="text-link" href={pagePath(locale, 'contribute')}>{t('contributeLink')}</a>
          </section>
          <p class="disclaimer">{t('disclaimer')}</p>
        </>
      )}
    </div>
  </>
)}
